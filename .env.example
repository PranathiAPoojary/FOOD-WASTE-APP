# Port configuration
PORT=3000

# Cloud SQL / PostgreSQL Runtime Connection Variables (Object Method)
SQL_HOST="127.0.0.1"
SQL_DB_NAME="foodcycle"
SQL_USER="foodcycle_app"
SQL_PASSWORD="your_app_password"

# Schema Management Variables (for Drizzle migrations)
SQL_ADMIN_USER="foodcycle_admin"
SQL_ADMIN_PASSWORD="your_admin_password"

# Application URL
APP_URL="http://localhost:3000"
