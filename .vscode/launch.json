{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Full-Stack (Node & Vite)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "restart": true
    },
    {
      "name": "Run Python Flask Backend",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend_flask/app.py",
      "cwd": "${workspaceFolder}/backend_flask",
      "console": "integratedTerminal",
      "env": {
        "FLASK_ENV": "development",
        "FLASK_DEBUG": "1",
        "PORT": "5000"
      }
    }
  ]
}
